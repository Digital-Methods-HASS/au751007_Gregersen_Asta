scale_fill_manual(
values = c(
"Before absolutism" = "grey70",
"During absolutism" = "purple"
)
) +
labs(
title = "Distribution of reign length before and during absolutism, Denmark",
x = "",
y = "Number of years ruled",
fill = "Period"
) +
theme_minimal()
